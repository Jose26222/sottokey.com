{
  "name": "sottokey-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && mkdir -p dist/.openai && cp .openai/hosting.json dist/.openai/hosting.json",
    "start": "vinext start",
    "start:test": "HOST=127.0.0.1 PORT=3100 vinext start",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "playwright test",
    "test:visual": "playwright test tests/visual.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.28",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.10",
    "react-server-dom-webpack": "^19.2.7",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.2",
    "vite": "^8.1.5"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
